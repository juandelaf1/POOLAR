# Variables de entorno para Poolar (desarrollo).
# NO incluir valores reales en el repositorio; copiar y personalizar.

# --- SQLite (desarrollo local rápido) ---
# DATABASE_URL=sqlite:///./poolar.db

# --- PostgreSQL (producción / CI) ---
POSTGRES_DB=poolar
POSTGRES_USER=trama
POSTGRES_PASSWORD=example-password-change-me-local-only

DATABASE_URL=postgresql+psycopg2://trama:example-password-change-me-local-only@localhost:5432/poolar
POOLAR_SECRET_KEY=please-replace-with-a-secure-random-secret-for-development-only-0123456789abcdef
POOLAR_DEMO_MODE=false
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
