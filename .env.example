# Variables de entorno para Trama Abierta (desarrollo).
# NO incluir valores reales en el repositorio; copiar y personalizar.

POSTGRES_DB=trama_abierta
POSTGRES_USER=trama
POSTGRES_PASSWORD=example-password-change-me-local-only

DATABASE_URL=postgresql+psycopg2://trama:example-password-change-me-local-only@localhost:5432/trama_abierta
TRAMA_ABIERTA_SECRET_KEY=please-replace-with-a-secure-random-secret-for-development-only-0123456789abcdef
TRAMA_DEMO_MODE=false
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
